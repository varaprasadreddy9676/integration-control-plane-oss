# Production environment — Docker deployment
# Copy this file to .env.prod and fill in real values.
# .env.prod is gitignored and must NEVER be committed.
#
# Usage:
#   sudo docker compose -f docker-compose.prod.yml --env-file .env.prod build
#   sudo docker compose -f docker-compose.prod.yml --env-file .env.prod up -d

# ── Ports ──────────────────────────────────────────────────────────────────
# Port the backend container binds on the host.
# Must match your reverse proxy / ALB target group port.
BACKEND_PORT=3545

# Port the frontend nginx container binds on the host.
# Your reverse proxy should forward /your-frontend-path/ to this port.
FRONTEND_PORT=8091

# ── Backend ────────────────────────────────────────────────────────────────
# MongoDB connection string.
# If MongoDB runs on the host (not in Docker), replace "localhost" with
# "host.docker.internal" so the container can reach the host network.
# Example (host MongoDB): mongodb://dbuser:dbpassword@host.docker.internal:27017/mydb
# Example (Docker MongoDB): mongodb://dbuser:dbpassword@mongodb:27017/mydb
MONGODB_URI=mongodb://YOUR_DB_USER:YOUR_DB_PASSWORD@host.docker.internal:YOUR_MONGO_PORT/YOUR_DB_NAME

MONGODB_DATABASE=integration_gateway

# Optional shared system API key for callers that can't use their own key.
# Prefer per-organization keys: Settings > API Keys > "Run integrations only".
# Generate a strong random string — e.g.: openssl rand -hex 32
API_KEY=your_api_key_here

# Organizations the shared API_KEY may act for (comma-separated). Without it,
# the shared key can act for every organization.
API_KEY_ORG_IDS=

# JWT secret for signing session tokens.
# Generate a strong random string — e.g.: openssl rand -hex 64
JWT_SECRET=your_jwt_secret_here

# Encryption key for integration credentials and gateway secrets (64 hex chars).
# Generate once:  openssl rand -hex 32
# Moving an existing server to Docker? Use that server's CURRENT key (from your
# password manager), not a new one — otherwise stored credentials cannot be read.
# Keep a copy in your password manager, never next to database backups.
GATEWAY_SECRET_KEY=your_64_hex_char_key_here

# URL of the frontend as seen by end-users (used for CORS and redirect URLs).
FRONTEND_URL=https://yourdomain.com/integration-gateway

# ── Optional backend tuning ────────────────────────────────────────────────
# AI_DEFAULT_TIMEOUT_MS=120000
# AI_LOCAL_RUNTIME_ALLOW_LOOPBACK=false
# INBOUND_MINIMAL_LOGGING=false

# ── Frontend build args ────────────────────────────────────────────────────
# The backend API base URL that gets BAKED INTO the frontend JS bundle.
# This must be the public URL that browsers can reach.
# Changing this requires rebuilding the frontend image.
VITE_API_BASE_URL=https://yourdomain.com/your-api-path/api/v1

# App display name shown in the browser tab and header.
VITE_APP_NAME=Integration Gateway

VITE_APP_VERSION=2.0.0
