# Integration Gateway - Backend Environment Variables
# Copy this file to .env and update with your values

# Server
PORT=3545
NODE_ENV=production
# TRUST_PROXY=true

# Global API rate limit (all backend routes)
# API_RATE_LIMIT_ENABLED=true
# API_RATE_LIMIT_MAX_REQUESTS=100
# API_RATE_LIMIT_WINDOW_SECONDS=60

# MongoDB
MONGODB_URI=mongodb://user:password@host:port/database
MONGODB_DATABASE=integration_gateway

# Security (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
API_KEY=your-secret-api-key-change-me
JWT_SECRET=your-jwt-secret-change-me-use-long-random-string

# Encryption key for stored credentials (gateway_secrets: DB passwords, API keys,
# Script Job environment variables). REQUIRED IN PRODUCTION.
#
# If unset, the key is derived from MONGODB_URI instead — which silently ties every
# stored secret to the connection string. Change the Mongo password, host or database
# name and none of them can ever be decrypted again. The app logs a warning at startup
# when it falls back; set GATEWAY_SECRET_KEY_REQUIRED=true to make it refuse to boot.
#
# Generate:  node src/scripts/rotate-gateway-secret-key.js --generate-key
# Migrate existing secrets onto a new key (dry run first, then --commit):
#            node src/scripts/rotate-gateway-secret-key.js --to=<key> [--commit]
GATEWAY_SECRET_KEY=
# GATEWAY_SECRET_KEY_REQUIRED=true

# Optional: Communication / Frontend URLs
# COMMUNICATION_SERVICE_URL=https://your-domain.com/api/sendNotification
# FRONTEND_URL=https://your-domain.com
